# =============================================
# Copy file này thành .env rồi điền giá trị thật
# KHÔNG commit file .env vào git
# =============================================

# DATABASE — Postgres (local Docker hoặc Supabase)
# Local Docker: postgresql://postgres:postgres@localhost:5432/kb_local
# Supabase:     postgresql://postgres:<PASSWORD>@db.<PROJECT_ID>.supabase.co:5432/postgres
DATABASE_URL=

# SUPABASE
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=

# GOOGLE GEMINI AI
GEMINI_API_KEY=
# Key Gemini dự phòng (tuỳ chọn) — tự động dùng khi key chính hết quota, để trống nếu chỉ có 1 key
GEMINI_API_KEY_2=
# Model Gemini nhẹ dùng khi model chính báo quá tải (503) kéo dài (tuỳ chọn, mặc định gemini-3.5-flash-lite)
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# AI CHAT — Anthropic Claude (TUỲ CHỌN)
# Chỉ chạy khi Admin chọn Claude ở trang Cấu hình AI (tính tiền theo token nên không tự làm dự phòng).
ANTHROPIC_API_KEY=
# Model mặc định (Admin vẫn đổi được trong giao diện): claude-sonnet-5 | claude-opus-5 | claude-haiku-4-5
# CLAUDE_MODEL=claude-sonnet-5

# SERVER
PORT=3000
NODE_ENV=development

# CORS — URL của Frontend (Vite dev: http://localhost:5173)
FRONTEND_URL=http://localhost:5173

# ─── Telegram Bot (tuỳ chọn) ────────────────────────────────────────────────
# Lấy từ @BotFather trên Telegram. KHÔNG có biến này thì backend vẫn chạy bình thường,
# chỉ là bot không khởi động.
TELEGRAM_BOT_TOKEN=
# Câu hướng dẫn hiện cho người đang chờ Admin duyệt quyền dùng bot.
TELEGRAM_ADMIN_CONTACT=Vui long lien he quan tri vien de duoc cap quyen.
