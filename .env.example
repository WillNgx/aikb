# =============================================
# Copy file này thành .env rồi điền giá trị thật
# KHÔNG commit file .env vào git
# =============================================

# DATABASE — Postgres (local Docker hoặc Supabase)
# Local Docker: postgresql://postgres:postgres@localhost:5432/kb_local
# Supabase:     postgresql://postgres:<PASSWORD>@db.<PROJECT_ID>.supabase.co:5432/postgres
DATABASE_URL=

# SUPABASE
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=

# GOOGLE GEMINI AI
GEMINI_API_KEY=
# Key Gemini dự phòng (tuỳ chọn) — tự động dùng khi key chính hết quota, để trống nếu chỉ có 1 key
GEMINI_API_KEY_2=

# AI CHAT — Cổng trung chuyển tự cấu hình (TUỲ CHỌN)
# Dùng cho các gateway tương thích chuẩn OpenAI (one-api/new-api, AIHubMix...) gộp nhiều nhà
# cung cấp sau một endpoint. Đặt tên CUSTOM_ thay vì tên riêng của một cổng để sau này đổi nhà
# cung cấp chỉ phải sửa giá trị, không phải đổi tên biến trong code.
# LƯU Ý VỀ DỮ LIỆU: câu hỏi đi qua cổng này thì toàn bộ nội dung KB nằm trong prompt sẽ đi qua
# máy chủ bên thứ ba — cân nhắc trước khi dùng cho tài liệu nội bộ.
CUSTOM_API_KEY=
# Hai biến dưới có giá trị mặc định trong code, xoá đi backend vẫn chạy bình thường.
# Xem cổng cho phép model nào: bấm "Tải danh sách model" ở trang Cấu hình AI, hoặc chạy
#   curl.exe -s <CUSTOM_BASE_URL>/models -H "Authorization: Bearer <CUSTOM_API_KEY>"
CUSTOM_BASE_URL=https://gateway.agents.ai.vn/v1
# Chỉ là model MẶC ĐỊNH của cổng. Model đang chạy thật do Admin chọn trong UI và lưu ở
# app_settings.chat_model — sửa biến này không đổi được model đang chạy.
CUSTOM_MODEL=deepseek.v3.2

# SERVER
PORT=3000
NODE_ENV=development

# CORS — URL của Frontend (Vite dev: http://localhost:5173)
FRONTEND_URL=http://localhost:5173

# ─── Telegram Bot (tuỳ chọn) ────────────────────────────────────────────────
# Lấy từ @BotFather trên Telegram. KHÔNG có biến này thì backend vẫn chạy bình thường,
# chỉ là bot không khởi động.
TELEGRAM_BOT_TOKEN=
# Câu hướng dẫn hiện cho người đang chờ Admin duyệt quyền dùng bot.
TELEGRAM_ADMIN_CONTACT=Vui long lien he quan tri vien de duoc cap quyen.
